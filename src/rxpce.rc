/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MENU MENU DISCARDABLE
BEGIN
    POPUP "&Game"
    BEGIN
        MENUITEM "&Open...", IDC_OPEN
        POPUP "Recent &Games"
        BEGIN
            MENUITEM "(No recent games)", IDC_RECENT_GAME_EMPTY, GRAYED
        END
        MENUITEM "&Assign Selected Profile to Last Game", IDC_ASSIGN_GAME_PROFILE, GRAYED
        MENUITEM "&Clear Last Game Profile", IDC_CLEAR_GAME_PROFILE, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Save State\tF5", IDC_SAVE, GRAYED
        MENUITEM "&Load State\tF6", IDC_LOAD, GRAYED
        MENUITEM "&Memory Search...\tF9", IDC_MEMORY_SEARCH, GRAYED
        MENUITEM "Cheat &Editor...\tAlt+F9", IDC_MEMORY_CHEATS, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "&Reset\tF10", IDC_RESET, GRAYED
        MENUITEM "S&top Emulation\tEsc", IDC_STOP, GRAYED
        POPUP "Repla&y"
        BEGIN
            MENUITEM "Start / Stop &Recording\tF11", IDC_REPLAY_RECORD, GRAYED
            MENUITEM "&Play / Stop Replay\tF12", IDC_REPLAY_PLAY
            MENUITEM "&Save Pending Recording...", IDC_REPLAY_SAVE, GRAYED
            MENUITEM "&Discard Pending Recording", IDC_REPLAY_DISCARD, GRAYED
        END
        MENUITEM "E&xit\tAlt+F4", IDC_EXIT
    END
    POPUP "&View"
    BEGIN
        MENUITEM "&Window Scale\tF8", IDC_ZOOM1
        MENUITEM "&Fullscreen\tAlt+Enter", IDC_FULLSCREEN
        MENUITEM SEPARATOR
        MENUITEM "&Settings...", IDC_SETTINGS
        POPUP "&Input Profiles"
        BEGIN
            MENUITEM "1  Profile 1\tAlt+1", IDC_INPUT_PROFILE_FIRST, CHECKED
            MENUITEM "2  Profile 2\tAlt+2", IDC_INPUT_PROFILE_FIRST + 1
            MENUITEM "3  Profile 3\tAlt+3", IDC_INPUT_PROFILE_FIRST + 2
            MENUITEM "4  Profile 4\tAlt+4", IDC_INPUT_PROFILE_FIRST + 3
            MENUITEM "5  Profile 5\tAlt+5", IDC_INPUT_PROFILE_FIRST + 4
            MENUITEM "6  Profile 6\tAlt+6", IDC_INPUT_PROFILE_FIRST + 5
            MENUITEM "7  Profile 7\tAlt+7", IDC_INPUT_PROFILE_FIRST + 6
            MENUITEM "8  Profile 8\tAlt+8", IDC_INPUT_PROFILE_FIRST + 7
            MENUITEM "9  Profile 9\tAlt+9", IDC_INPUT_PROFILE_FIRST + 8
            MENUITEM "10  Profile 10\tAlt+0", IDC_INPUT_PROFILE_LAST
        END
        MENUITEM SEPARATOR
        MENUITEM "&About rxpce...", IDC_ABOUT
    END
END


